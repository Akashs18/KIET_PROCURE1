//  ITEM LIST (client-side helpers)
// ──────────────────────────────────────────────────────
let items = [];

async function items_load() {
  try {
    const res = await fetch('/api/items');
    if (!res.ok) throw new Error('Failed to load items');
    items = await res.json();
  } catch(err) {
    console.error('items_load err', err);
    items = [];
  }
}

function items_openAddModal() {
  document.getElementById('it-name').value = '';
  document.getElementById('it-opening').value = '0';
  document.getElementById('it-closing').value = '0';
  document.getElementById('items-add-modal').classList.add('open');
}
function items_closeAddModal() { document.getElementById('items-add-modal').classList.remove('open'); }

async function items_add() {
  const name = document.getElementById('it-name').value.trim();
  const opening = parseFloat(document.getElementById('it-opening').value) || 0;
  const closing = parseFloat(document.getElementById('it-closing').value);
  if (!name) { toast('error','Validation','Item name required'); return; }
  try {
    const res = await fetch('/api/items', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ name, opening_qty: opening, closing_qty: isNaN(closing)?opening:closing }) });
    const data = await res.json();
    if (res.ok && data.success) {
      toast('success','Added','Item added to list');
      await items_load();
      // if user currently entered this item in stock form, update opening/closing fields
      const cur = (document.getElementById('sr-item-name')||{}).value || '';
      if (cur.trim().toLowerCase() === name.toLowerCase()) {
        document.getElementById('sr-opening-qty').value = opening;
        document.getElementById('sr-closing-qty').value = isNaN(closing)?opening:closing;
      }
      items_closeAddModal();
    } else {
      toast('error','Failed', data.error || 'Could not add item');
    }
  } catch(err) { console.error(err); toast('error','Error','Network error while adding item'); }
}

function items_openListModal() {
  items_renderList();
  document.getElementById('items-list-modal').classList.add('open');
}
function items_closeListModal() { document.getElementById('items-list-modal').classList.remove('open'); }

function items_renderList() {
  const q = (document.getElementById('items-list-search').value || '').toLowerCase();
  const list = items.filter(it => !q || (it.name||'').toLowerCase().includes(q));
  if (!list.length) {
    document.getElementById('items-list-content').innerHTML = '<p style="padding:12px;color:var(--text-3)">No items found.</p>';
    return;
  }
  const rows = list.map(it => `<tr>
      <td style="font-weight:600">${it.name}</td>
      <td style="text-align:right">${it.opening_qty||0}</td>
      <td style="text-align:right">${it.closing_qty||0}</td>
      <td style="text-align:right"><button class="btn btn-sm btn-primary" onclick="items_use('${encodeURIComponent(it.name)}')">Use</button></td>
    </tr>`).join('');
  document.getElementById('items-list-content').innerHTML = `<table><thead><tr><th>Item</th><th>Opening Qty</th><th>Closing Qty</th><th></th></tr></thead><tbody>${rows}</tbody></table>`;
}

function items_use(encodedName) {
  const name = decodeURIComponent(encodedName);
  const it = items.find(i => (i.name||'').toLowerCase() === name.toLowerCase());
  if (!it) return;
  document.getElementById('sr-item-name').value = it.name;
  document.getElementById('sr-opening-qty').value = it.opening_qty || 0;
  document.getElementById('sr-closing-qty').value = it.closing_qty || 0;
  items_closeListModal();
}

function items_lookupByName() {
  const name = (document.getElementById('sr-item-name').value || '').trim();
  if (!name) return;
  const it = items.find(i => (i.name||'').toLowerCase() === name.toLowerCase());
  if (it) {
    document.getElementById('sr-opening-qty').value = it.opening_qty || 0;
    document.getElementById('sr-closing-qty').value = it.closing_qty || 0;
  }
}

// attach lookup to input blur
document.addEventListener('click', function(e){
  // attach once after DOM ready — ensure element exists
  const el = document.getElementById('sr-item-name');
  if (el && !el._items_bound) {
    el.addEventListener('blur', items_lookupByName);
    el._items_bound = true;
  }
});

// ── Download as CSV/Excel ──────────────────────────────────
function sr_downloadExcel() {
  const data = srFiltered.length ? srFiltered : srEntries.filter(e => (e.department || 'EC LAB') === currentSrDept);
  if (!data.length) { toast('error','No Data','Nothing to download.'); return; }

  const headers = ['Sl.No','Department','DC Number','Date','Item Name','Description','Project Name',
                   'Opening Qty','Issues','Returned','Closing Qty','Issued To','Remarks'];
  let csv = headers.join(',') + '\n';

  data.forEach((e, i) => {
    const row = [
      i+1,
      e.department   || 'EC LAB',
      e.dc_number    || '',
      e.date ? new Date(e.date).toLocaleDateString('en-IN') : '',
      e.item_name    || '',
      e.description  || '',
      e.project_name || '',
      e.opening_qty  ?? 0,
      e.issues       ?? 0,
      e.returned     ?? 0,
      e.closing_qty  ?? 0,
      e.issued_to    || '',
      e.remarks      || ''
    ].map(v => `"${String(v).replace(/"/g,'""')}"`);
    csv += row.join(',') + '\n';
  });

  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([csv], {type:'text/csv'}));
  a.download = `stock-register-${currentSrDept.replace(/\s+/g, '_')}-${new Date().toISOString().split('T')[0]}.csv`;
  a.click();
  toast('success','Downloaded','Stock register exported as CSV.');
}

