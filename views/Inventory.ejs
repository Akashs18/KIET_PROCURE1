  const input = String(value || '').trim().toLowerCase();
  if (!input) return 'ELCAB';
  if (['elcab','ec lab','ec-lab','ec_lab'].includes(input)) return 'ELCAB';
  if (['mechanical','mech'].includes(input)) return 'Mechanical';
  if (['electrical','elec'].includes(input)) return 'Electrical';
  return value || 'ELCAB';
}

