let srEntries   = [];   // raw data from server
let srFiltered  = [];   // after search/filter
let srPage      = 1;
const SR_PER_PAGE = 20;
let currentSrDept = 'EC LAB';

// ── Department Tabs switching ──────────────────────────────
function sr_switchDept(dept) {
  currentSrDept = dept;
  document.querySelectorAll('#stock-register .inner-tabs .inner-tab').forEach(t => {
    t.classList.remove('active');
  });
  if (dept === 'EC LAB') document.getElementById('sr-tab-ec').classList.add('active');
  else if (dept === 'MECHANICAL') document.getElementById('sr-tab-mech').classList.add('active');
  else if (dept === 'ELECTRICAL') document.getElementById('sr-tab-elec').classList.add('active');

  const deptSelect = document.getElementById('sr-department');
  if (deptSelect) {
    deptSelect.value = dept;
  }

  sr_filterTable();
  sr_updateStats();
}

// ── Closing Qty auto-calc ──────────────────────────────────
function sr_calcClosing() {
  const open    = parseFloat(document.getElementById('sr-opening-qty').value) || 0;
  const issues  = parseFloat(document.getElementById('sr-issues').value)      || 0;
  const ret     = parseFloat(document.getElementById('sr-returned').value)    || 0;
  document.getElementById('sr-closing-qty').value = Math.max(0, open - issues + ret);
}

function sr_editCalcClosing() {
  const open   = parseFloat(document.getElementById('sr-e-opening').value)  || 0;
  const issues = parseFloat(document.getElementById('sr-e-issues').value)   || 0;
  const ret    = parseFloat(document.getElementById('sr-e-returned').value) || 0;
  document.getElementById('sr-e-closing').value = Math.max(0, open - issues + ret);
}

// ── Toggle form visibility ─────────────────────────────────
function sr_toggleForm() {
  const body = document.getElementById('sr-form-body');
  const chevron = document.getElementById('sr-form-chevron');
  if (body.style.display === 'none') {
    body.style.display = '';
    chevron.className = 'fas fa-chevron-up';
  } else {
    body.style.display = 'none';
    chevron.className = 'fas fa-chevron-down';
  }
}

// ── Clear form ─────────────────────────────────────────────
function sr_clearForm() {
  ['sr-dc-number','sr-item-name','sr-description','sr-project-name',
   'sr-issued-to','sr-opening-qty','sr-remarks'].forEach(id => {
    document.getElementById(id).value = '';
  });
  document.getElementById('sr-issues').value   = '0';
  document.getElementById('sr-returned').value = '0';
  document.getElementById('sr-closing-qty').value = '';
  document.getElementById('sr-date').value = new Date().toISOString().split('T')[0];
  document.getElementById('sr-department').value = currentSrDept;
}

// ── Load entries from API ──────────────────────────────────
async function sr_loadEntries() {
  try {
    const res  = await fetch('/api/stock-register');
    const data = await res.json();
    srEntries  = Array.isArray(data) ? data : [];
    sr_filterTable();
    sr_updateStats();
  } catch(e) {
    console.error('SR load error:', e);
    srEntries = [];
    sr_renderTable([]);
  }
}

// ── Save new entry ─────────────────────────────────────────
async function sr_saveEntry() {
  const itemName = document.getElementById('sr-item-name').value.trim();
  const date     = document.getElementById('sr-date').value;
  const opening  = document.getElementById('sr-opening-qty').value;

  if (!itemName) { toast('error','Validation','Item Name is required.'); return; }
  if (!date)     { toast('error','Validation','Date is required.');      return; }
  if (opening === '') { toast('error','Validation','Opening Qty is required.'); return; }

  const payload = {
    dc_number:    document.getElementById('sr-dc-number').value.trim(),
    date,
    item_name:    itemName,
    description:  document.getElementById('sr-description').value.trim(),
    project_name: document.getElementById('sr-project-name').value.trim(),
    issued_to:    document.getElementById('sr-issued-to').value.trim(),
    opening_qty:  parseFloat(opening) || 0,
    issues:       parseFloat(document.getElementById('sr-issues').value)   || 0,
    returned:     parseFloat(document.getElementById('sr-returned').value) || 0,
    closing_qty:  parseFloat(document.getElementById('sr-closing-qty').value) || 0,
    remarks:      document.getElementById('sr-remarks').value.trim(),
    department:   document.getElementById('sr-department').value,
  };

  try {
    const res  = await fetch('/api/stock-register', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify(payload)
    });
    const data = await res.json();
    if (data.success) {
      toast('success','Saved','Stock register entry saved.');
      sr_clearForm();
      await sr_loadEntries();
      await items_load();
    } else {
      toast('error','Error', data.error || 'Failed to save.');
    }
  } catch(e) {
    toast('error','Error','Network error while saving.');
  }
}

// ── Open Edit modal ────────────────────────────────────────
function sr_openEditModal(id) {
  const entry = srEntries.find(e => e.id == id);
  if (!entry) return;

  document.getElementById('sr-edit-id').value    = entry.id;
  document.getElementById('sr-edit-sub').textContent = `Sl.No: ${entry.sl_no || entry.id}`;
  document.getElementById('sr-e-dc').value       = entry.dc_number   || '';
  document.getElementById('sr-e-date').value     = entry.date ? entry.date.substring(0,10) : '';
  document.getElementById('sr-e-item').value     = entry.item_name   || '';
  document.getElementById('sr-e-desc').value     = entry.description || '';
  document.getElementById('sr-e-project').value  = entry.project_name|| '';
  document.getElementById('sr-e-issued-to').value= entry.issued_to   || '';
  document.getElementById('sr-e-opening').value  = entry.opening_qty ?? 0;
  document.getElementById('sr-e-issues').value   = entry.issues      ?? 0;
  document.getElementById('sr-e-returned').value = entry.returned    ?? 0;
  document.getElementById('sr-e-closing').value  = entry.closing_qty ?? 0;
  document.getElementById('sr-e-remarks').value  = entry.remarks     || '';
  document.getElementById('sr-e-department').value = entry.department || 'EC LAB';

  document.getElementById('sr-edit-modal').classList.add('open');
}

function sr_closeEditModal() {
  document.getElementById('sr-edit-modal').classList.remove('open');
}

// ── Submit Edit ────────────────────────────────────────────
async function sr_submitEdit() {
  const id       = document.getElementById('sr-edit-id').value;
  const itemName = document.getElementById('sr-e-item').value.trim();
  const date     = document.getElementById('sr-e-date').value;
  if (!itemName || !date) { toast('error','Validation','Item Name & Date required.'); return; }

  const payload = {
    dc_number:    document.getElementById('sr-e-dc').value.trim(),
    date,
    item_name:    itemName,
    description:  document.getElementById('sr-e-desc').value.trim(),
    project_name: document.getElementById('sr-e-project').value.trim(),
    issued_to:    document.getElementById('sr-e-issued-to').value.trim(),
    opening_qty:  parseFloat(document.getElementById('sr-e-opening').value)  || 0,
    issues:       parseFloat(document.getElementById('sr-e-issues').value)   || 0,
    returned:     parseFloat(document.getElementById('sr-e-returned').value) || 0,
    closing_qty:  parseFloat(document.getElementById('sr-e-closing').value)  || 0,
    remarks:      document.getElementById('sr-e-remarks').value.trim(),
    department:   document.getElementById('sr-e-department').value,
  };

  try {
    const res  = await fetch(`/api/stock-register/${id}`, {
      method: 'PUT',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify(payload)
    });
    const data = await res.json();
    if (data.success) {
      toast('success','Updated','Entry updated successfully.');
      sr_closeEditModal();
      await sr_loadEntries();
      await items_load();
    } else {
      toast('error','Error', data.error || 'Failed to update.');
    }
  } catch(e) {
    toast('error','Error','Network error while updating.');
  }
}

// ── Open Return modal ──────────────────────────────────────
function sr_openReturnModal(id) {
  const entry = srEntries.find(e => e.id == id);
  if (!entry) return;

  document.getElementById('sr-return-id').value = entry.id;
  document.getElementById('sr-return-sub').textContent = `Item: ${entry.item_name}`;
  document.getElementById('sr-return-current-closing').value = entry.closing_qty ?? 0;
  document.getElementById('sr-return-qty').value     = '';
  document.getElementById('sr-return-new-closing').value = entry.closing_qty ?? 0;
  document.getElementById('sr-return-remarks').value = '';

  document.getElementById('sr-return-modal').classList.add('open');
}

function sr_closeReturnModal() {
  document.getElementById('sr-return-modal').classList.remove('open');
}

// ── Submit Return ──────────────────────────────────────────
async function sr_submitReturn() {
  const id      = document.getElementById('sr-return-id').value;
  const retQty  = parseFloat(document.getElementById('sr-return-qty').value);
  const remarks = document.getElementById('sr-return-remarks').value.trim();

  if (!retQty || retQty <= 0) { toast('error','Validation','Enter a valid return quantity.'); return; }

  try {
    const res  = await fetch(`/api/stock-register/${id}/return`, {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ return_qty: retQty, remarks })
    });
    const data = await res.json();
    if (data.success) {
      toast('success','Returned',`Closing qty updated to ${data.new_closing_qty}.`);
      sr_closeReturnModal();
      await sr_loadEntries();
      await items_load();
    } else {
      toast('error','Error', data.error || 'Failed to record return.');
    }
  } catch(e) {
    toast('error','Error','Network error while recording return.');
  }
}

// ── Filter / search ────────────────────────────────────────
function sr_filterTable() {
  const q    = (document.getElementById('sr-search').value || '').toLowerCase();
  const fDate= document.getElementById('sr-filter-date').value;

  srFiltered = srEntries.filter(e => {
    const matchDept = (e.department || 'EC LAB') === currentSrDept;

    const matchQ = !q ||
      (e.dc_number   || '').toLowerCase().includes(q) ||
      (e.item_name   || '').toLowerCase().includes(q) ||
      (e.description || '').toLowerCase().includes(q) ||
      (e.project_name|| '').toLowerCase().includes(q) ||
      (e.issued_to   || '').toLowerCase().includes(q) ||
      (e.remarks     || '').toLowerCase().includes(q);

    const matchD = !fDate || (e.date && e.date.substring(0,10) === fDate);
    return matchDept && matchQ && matchD;
  });

  srPage = 1;
  sr_renderTable(srFiltered);
}

// ── Render table rows ──────────────────────────────────────
function sr_renderTable(data) {
  const tbody = document.getElementById('sr-tbody');
  const badge = document.getElementById('sr-table-badge');
  if (!tbody) return;
  if (badge) badge.textContent = data.length;

  if (!data.length) {
    tbody.innerHTML = `<tr><td colspan="13"><div class="empty-state" style="padding:30px">
      <i class="fas fa-clipboard-list"></i><h3>No entries found</h3><p>Try adjusting your search or add a new entry.</p>
    </div></td></tr>`;
    document.getElementById('sr-pag').style.display = 'none';
    return;
  }

  const total = data.length;
  const pages = Math.ceil(total / SR_PER_PAGE);
  if (srPage > pages) srPage = pages;

  const start = (srPage - 1) * SR_PER_PAGE;
  const slice = data.slice(start, start + SR_PER_PAGE);

  tbody.innerHTML = slice.map((e, i) => {
    const rowNum = start + i + 1;
    const dateStr = e.date ? new Date(e.date).toLocaleDateString('en-IN') : '—';
    const closingClass = (e.closing_qty > 0) ? 'color:var(--green);font-weight:700' : 'color:var(--red);font-weight:700';
    return `<tr>
      <td class="td-mono">${rowNum}</td>
      <td>${e.dc_number || '—'}</td>
      <td>${dateStr}</td>
      <td style="font-weight:500">${e.item_name || '—'}</td>
      <td class="td-muted">${e.description || '—'}</td>
      <td>${e.project_name || '—'}</td>
      <td style="text-align:right">${e.opening_qty ?? 0}</td>
      <td style="text-align:right;color:var(--red)">${e.issues ?? 0}</td>
      <td style="text-align:right;color:var(--purple)">${e.returned ?? 0}</td>
      <td style="text-align:right;${closingClass}">${e.closing_qty ?? 0}</td>
      <td>${e.issued_to || '—'}</td>
      <td class="td-muted">${e.remarks || '—'}</td>
      <td>
        <div style="display:flex;gap:5px;flex-wrap:wrap">
          <button class="btn btn-secondary btn-sm" onclick="sr_openReturnModal(${e.id})" title="Record Return">
            <i class="fas fa-undo"></i> Return
          </button>
          <button class="btn btn-secondary btn-sm" onclick="sr_openEditModal(${e.id})" title="Edit">
            <i class="fas fa-edit"></i> Edit
          </button>
        </div>
      </td>
    </tr>`;
  }).join('');

  // Pagination
  const pagEl      = document.getElementById('sr-pag');
  const pagInfo    = document.getElementById('sr-pag-info');
  const pagBtns    = document.getElementById('sr-pag-btns');

  pagEl.style.display = pages > 1 ? '' : 'none';
  pagInfo.textContent = `Showing ${start+1}–${Math.min(start+SR_PER_PAGE, total)} of ${total}`;

  let btns = `<button class="pag-btn ${srPage===1?'disabled':''}" onclick="sr_goPage(${srPage-1})"><i class="fas fa-chevron-left"></i></button>`;
  for (let p = 1; p <= pages; p++) {
    if (pages <= 7 || p===1 || p===pages || Math.abs(p-srPage)<=1) {
      btns += `<button class="pag-btn ${p===srPage?'active':''}" onclick="sr_goPage(${p})">${p}</button>`;
    } else if (Math.abs(p-srPage)===2) {
      btns += `<button class="pag-btn disabled">…</button>`;
    }
  }
  btns += `<button class="pag-btn ${srPage===pages?'disabled':''}" onclick="sr_goPage(${srPage+1})"><i class="fas fa-chevron-right"></i></button>`;
  pagBtns.innerHTML = btns;
}

function sr_goPage(p) {
  const pages = Math.ceil(srFiltered.length / SR_PER_PAGE);
  if (p < 1 || p > pages) return;
  srPage = p;
  sr_renderTable(srFiltered);
}

// ── Stats ──────────────────────────────────────────────────
function sr_updateStats() {
  const deptEntries = srEntries.filter(e => (e.department || 'EC LAB') === currentSrDept);
  document.getElementById('sr-stat-total').textContent    = deptEntries.length;
  document.getElementById('sr-stat-opening').textContent  = deptEntries.reduce((s,e)=>s+(parseFloat(e.opening_qty)||0),0);
  document.getElementById('sr-stat-issued').textContent   = deptEntries.reduce((s,e)=>s+(parseFloat(e.issues)||0),0);
  document.getElementById('sr-stat-returned').textContent = deptEntries.reduce((s,e)=>s+(parseFloat(e.returned)||0),0);
}

