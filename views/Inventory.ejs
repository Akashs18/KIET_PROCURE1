// Legacy compat – called from switchTab and search
function sr2_selectDepartment(dept, el) {
  sr2_showDeptLayer();
}

function sr2_switchTab(tabId, el) {
  document.querySelectorAll('#stock-register .sr2-tab-content').forEach(t => t.style.display = 'none');
  document.querySelectorAll('#sr2-nav-tabs .inner-tab').forEach(t => t.classList.remove('active'));
  const panel = document.getElementById('sr2-' + tabId);
  if (panel) panel.style.display = 'block';
  if (el) el.classList.add('active');
  if (tabId === 'dashboard') sr2_loadDashboard();
  if (tabId === 'categories') sr2_loadCategories();
  if (tabId === 'items') sr2_loadItems();
  if (tabId === 'inward') sr2_loadInward();
  if (tabId === 'outward') sr2_loadOutward();
}

function sr2_closeModal(id) { document.getElementById(id).classList.remove('open'); }

// Dashboard
async function sr2_loadDashboard() {
  try {
    const res = await fetch('/api/inventory/dashboard?department=' + encodeURIComponent(currentInventoryDepartment));
    const d = await res.json();
    document.getElementById('sr2-stats-grid').innerHTML = `
      <div class="stat-card"><div class="stat-icon si-blue"><i class="fas fa-boxes"></i></div><div><div class="stat-value">${d.total_departments||0}</div><div class="stat-label">Departments</div></div></div>
      <div class="stat-card"><div class="stat-icon si-green"><i class="fas fa-tags"></i></div><div><div class="stat-value">${d.total_categories||0}</div><div class="stat-label">Categories</div></div></div>
      <div class="stat-card"><div class="stat-icon si-blue"><i class="fas fa-cubes"></i></div><div><div class="stat-value">${d.total_items||0}</div><div class="stat-label">Items</div></div></div>
      <div class="stat-card"><div class="stat-icon si-amber"><i class="fas fa-rupee-sign"></i></div><div><div class="stat-value">₹${(d.total_stock_value||0).toFixed(2)}</div><div class="stat-label">Stock Value</div></div></div>
      <div class="stat-card"><div class="stat-icon si-red"><i class="fas fa-exclamation-triangle"></i></div><div><div class="stat-value">${d.low_stock||0}</div><div class="stat-label">Low Stock</div></div></div>
      <div class="stat-card"><div class="stat-icon si-red"><i class="fas fa-ban"></i></div><div><div class="stat-value">${d.out_of_stock||0}</div><div class="stat-label">Out of Stock</div></div></div>
      <div class="stat-card"><div class="stat-icon si-green"><i class="fas fa-arrow-down"></i></div><div><div class="stat-value">${d.today_inward||0}</div><div class="stat-label">Today Inward</div></div></div>
      <div class="stat-card"><div class="stat-icon si-purple"><i class="fas fa-arrow-up"></i></div><div><div class="stat-value">${d.today_outward||0}</div><div class="stat-label">Today Outward</div></div></div>
    `;

    document.getElementById('sr2-catstock-table').querySelector('tbody').innerHTML = (d.category_stock||[]).map(r => `<tr><td>${r.category}</td><td>${r.total_qty}</td></tr>`).join('');
    document.getElementById('sr2-deptval-table').querySelector('tbody').innerHTML = (d.department_stock_value||[]).map(r => `<tr><td>${r.department}</td><td>₹${parseFloat(r.total_value||0).toFixed(2)}</td></tr>`).join('');

    const labels = (d.monthly_inward || []).map(r => r.month);
    const inward = (d.monthly_inward || []).map(r => parseFloat(r.total || 0));
    const outward = (d.monthly_outward || []).map(r => parseFloat(r.total || 0));
    if (sr2MovementChart) sr2MovementChart.destroy();
    const ctx = document.getElementById('sr2-movement-chart');
    if (ctx && typeof Chart !== 'undefined') {
      sr2MovementChart = new Chart(ctx, {
        type: 'bar',
        data: {
          labels,
          datasets: [
            { label: 'Inward', data: inward, backgroundColor: 'rgba(37, 99, 235, 0.7)' },
            { label: 'Outward', data: outward, backgroundColor: 'rgba(220, 38, 38, 0.7)' }
          ]
        },
        options: { responsive:true, plugins:{legend:{display:true}} }
      });
    }
  } catch(e) { console.error(e); }
}

// Categories
async function sr2_loadCategories() {
  try {
    const res = await fetch('/api/inventory/categories?department=' + encodeURIComponent(currentInventoryDepartment));
    const d = await res.json();
    document.getElementById('sr2-cat-table').querySelector('tbody').innerHTML = d.map(c => `<tr><td>${c.id}</td><td>${c.name}</td><td>${c.department}</td><td><button class="btn btn-sm btn-danger" onclick="sr2_delCategory(${c.id})"><i class="fas fa-trash"></i></button></td></tr>`).join('');
  } catch(e) { console.error(e); }
}

// Category Cards (drill-down layer 1)
async function sr2_loadCatCards() {
  const grid = document.getElementById('sr2-cat-cards-grid');
  grid.innerHTML = '<div style="color:var(--text-3);padding:20px">Loading categories…</div>';
  try {
    const res = await fetch('/api/inventory/categories?department=' + encodeURIComponent(currentInventoryDepartment));
    const cats = await res.json();
    if (!cats.length) {
      grid.innerHTML = '<div class="sr2-cat-empty"><i class="fas fa-tags"></i><p>No categories yet. Use "Manage Categories" to add one.</p></div>';
      return;
    }
    grid.innerHTML = cats.map(c => `
      <div class="sr2-cat-card" onclick="sr2_showItemsByCategory(${c.id}, '${(c.name||'').replace(/'/g,"\\'")}')">
        <div class="sr2-cat-card-icon"><i class="fas fa-tag"></i></div>
        <div class="sr2-cat-card-name">${c.name}</div>
        <div class="sr2-cat-card-meta">Click to view items</div>
        <div class="sr2-cat-card-arrow"><i class="fas fa-chevron-right"></i></div>
      </div>
    `).join('');
  } catch(e) { grid.innerHTML = '<div style="color:var(--red);padding:20px">Failed to load categories.</div>'; }
}

// Items by Category (drill-down layer 2)
async function sr2_loadCatItems(catId) {
  const tbody = document.getElementById('sr2-cat-items-tbody');
  tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:var(--text-3);padding:20px"><i class="fas fa-spinner fa-spin"></i> Loading items…</td></tr>';
  try {
    const targetCatId = catId || currentCategoryId;
    const res = await fetch(`/api/inventory/items?department=${encodeURIComponent(currentInventoryDepartment)}&category_id=${targetCatId}&page=1&per_page=200`);
    const data = await res.json();
    const items = data.items || data || [];
    if (!items.length) {
      tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:var(--text-3);padding:20px"><i class="fas fa-box-open"></i> No items in this category.</td></tr>';
      return;
    }
    tbody.innerHTML = items.map(i => {
      const avail = parseFloat(i.available_qty || 0);
      const min = parseFloat(i.min_stock || 0);
      const isOut = avail <= 0;
      const isLow = avail <= min;
      const stat = isOut ? '<span class="badge bd-red">Out of Stock</span>' : isLow ? '<span class="badge bd-amber">Low Stock</span>' : '<span class="badge bd-green">In Stock</span>';
      return `<tr>
        <td>${i.item_code||'-'}</td>
        <td>${i.name||'-'} <small class="td-muted">(ID: ${i.id})</small></td>
        <td style="font-weight:bold">${avail}</td>
        <td>${min} / ${parseFloat(i.max_stock||0)}</td>
        <td>${i.rack_number||'-'} / ${i.bin_number||'-'}</td>
        <td>${stat}</td>
        <td>
          <button class="btn btn-sm btn-secondary" onclick="sr2_editItem(${i.id},'${(i.item_code||'').replace(/'/g,"\\'")}','${(i.name||'').replace(/'/g,"\\'")}','${(i.department||'').replace(/'/g,"\\'")}','${(i.category_id||'').toString().replace(/'/g,"\\'")}','${i.min_stock||0}','${i.max_stock||0}','${(i.rack_number||'').replace(/'/g,"\\'")}','${(i.bin_number||'').replace(/'/g,"\\'")}')" title="Edit Item"><i class="fas fa-edit"></i> Edit</button>
          <button class="btn btn-sm btn-primary" onclick="sr2_openItemDetail(${i.id})" title="View Details"><i class="fas fa-eye"></i> View</button>
        </td>
      </tr>`;
    }).join('');
  } catch(e) { tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:var(--red);padding:20px">Failed to load items.</td></tr>'; }
}
async function sr2_addCategory(e) {
  e.preventDefault();
  const name = document.getElementById('sr2-cat-name').value.trim();
  const dept = normalizeDeptValue(document.getElementById('sr2-cat-dept').value);
  if (!name) return toast('error','Validation','Category name is required');
  try {
    const res = await fetch('/api/inventory/categories', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({name, department:dept}) });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Failed to add category');
    toast('success','Category Added','');
    e.target.reset();
    sr2_loadCategories();
  } catch(err) { toast('error','Error', err.message); }
}
async function sr2_delCategory(id) {
  if(!window.confirm('Delete this category?')) return;
  const res = await fetch('/api/inventory/categories/'+id, { method:'DELETE' });
  if (!res.ok) return toast('error','Error','Failed to delete');
  toast('success','Deleted','');
  sr2_loadCategories();
}

// Items
async function sr2_loadItems() {
  try {
    const s = document.getElementById('sr2-items-search').value;
    const deptSelect = document.getElementById('sr2-items-dept');
    const deptValue = deptSelect ? deptSelect.value : '';
    const d = deptValue ? normalizeDeptValue(deptValue) : '';
    const st = document.getElementById('sr2-items-stock').value;
    const res = await fetch(`/api/inventory/items?search=${encodeURIComponent(s)}&department=${encodeURIComponent(d)}&stock_filter=${st}&page=1&per_page=20`);
    const payload = await res.json();
    const items = Array.isArray(payload) ? payload : (payload.items || []);
    document.getElementById('sr2-items-table').querySelector('tbody').innerHTML = items.map(i => {
      const isLow = parseFloat(i.available_qty || 0) <= parseFloat(i.min_stock || 0);
      const isOut = parseFloat(i.available_qty || 0) <= 0;
      const stat = isOut ? '<span class="badge bd-red">Out of Stock</span>' : isLow ? '<span class="badge bd-amber">Low Stock</span>' : '<span class="badge bd-green">In Stock</span>';
      return `<tr>
        <td>${i.item_code || '-'}</td><td>${i.name || '-'} <small class="td-muted">(ID: ${i.id})</small></td><td>${i.department||'-'}</td><td>${i.category_name||'-'}</td>
        <td style="font-weight:bold">${parseFloat(i.available_qty || 0)}</td><td>${parseFloat(i.min_stock || 0)} / ${parseFloat(i.max_stock || 0)}</td><td>${i.rack_number||'-'} / ${i.bin_number||'-'}</td>
        <td>${stat}</td>
        <td>
          <button class="btn btn-sm btn-secondary" onclick="sr2_editItem(${i.id}, '${(i.item_code || '').replace(/'/g, "\\'")}', '${(i.name || '').replace(/'/g, "\\'")}', '${(i.department || '').replace(/'/g, "\\'")}', '${(i.category_id || '').replace(/'/g, "\\'")}', '${(i.min_stock || 0).toString().replace(/'/g, "\\'")}', '${(i.max_stock || 0).toString().replace(/'/g, "\\'")}', '${(i.rack_number || '').replace(/'/g, "\\'")}', '${(i.bin_number || '').replace(/'/g, "\\'")}')">Edit</button>
          <button class="btn btn-sm btn-primary" onclick="sr2_openItemDetail(${i.id})"><i class="fas fa-eye"></i></button>
        </td>
      </tr>`;
    }).join('');
  } catch(e) { console.error(e); }
}

async function sr2_refreshCategoryOptions(dept) {
  const select = document.getElementById('sr2-i-cat');
  if (!select) return;
  const normalized = normalizeDeptValue(dept || currentInventoryDepartment);
  try {
    const res = await fetch('/api/inventory/categories?department=' + encodeURIComponent(normalized));
    const categories = await res.json();
    const currentValue = select.value;
    select.innerHTML = '<option value="">Select category</option>' + categories.map(c => `<option value="${c.id}">${c.name}</option>`).join('');
    if (currentValue) select.value = currentValue;
  } catch (e) {
    console.error(e);
  }
}
function sr2_openItemModal() {
  document.getElementById('sr2-item-form').reset();
  document.getElementById('sr2-i-id').value = '';
  document.getElementById('sr2-i-dept').value = currentInventoryDepartment;
  document.getElementById('sr2-item-modal-title').textContent = 'Add Item';
  sr2_refreshCategoryOptions(currentInventoryDepartment).then(() => {
    if (currentCategoryId) {
      const catSelect = document.getElementById('sr2-i-cat');
      if (catSelect) catSelect.value = currentCategoryId;
    }
  });
  document.getElementById('sr2-item-modal').classList.add('open');
}
async function sr2_openItemDetail(id) {
  try {
    const itemRes = await fetch(`/api/inventory/items/${id}`);
    const item = await itemRes.json();
    const ledgerRes = await fetch(`/api/inventory/reports/item_ledger?item_id=${id}`);
    const ledger = await ledgerRes.json();
    sr2DetailItemId = id;
    document.getElementById('sr2-item-detail-body').innerHTML = `
      <div class="form-grid fg-2" style="margin-bottom:12px">
        <div><strong>Code</strong><div>${item.item_code || '-'}</div></div>
        <div><strong>Name</strong><div>${item.name || '-'}</div></div>
        <div><strong>Department</strong><div>${item.department || '-'}</div></div>
        <div><strong>Category</strong><div>${item.category_name || '-'}</div></div>
        <div><strong>Available Qty</strong><div>${parseFloat(item.available_qty || 0)}</div></div>
        <div><strong>Rack / Bin</strong><div>${item.rack_number || '-'} / ${item.bin_number || '-'}</div></div>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Type</th><th>Date</th><th>Ref</th><th>Qty In</th><th>Qty Out</th><th>Details</th></tr></thead>
          <tbody>${ledger.map(r => `<tr><td>${r.type}</td><td>${r.date ? r.date.substring(0,10) : '-'}</td><td>${r.ref_no || '-'}</td><td>${r.qty_in || 0}</td><td>${r.qty_out || 0}</td><td>${r.details || '-'}</td></tr>`).join('')}</tbody>
        </table>
      </div>`;
    document.getElementById('sr2-item-detail-modal').classList.add('open');
  } catch (e) { console.error(e); toast('error','Error',e.message); }
}
function sr2_editItem(id, code, name, dept, cat, min, max, rack, bin) {
  document.getElementById('sr2-i-id').value = id;
  document.getElementById('sr2-i-code').value = code !== 'null' ? code : '';
  document.getElementById('sr2-i-name').value = name;
  document.getElementById('sr2-i-dept').value = normalizeDeptValue(dept !== 'null' ? dept : 'ELCAB');
  document.getElementById('sr2-i-cat').value = cat !== 'null' ? cat : '';
  document.getElementById('sr2-i-min').value = min;
  document.getElementById('sr2-i-max').value = max;
  document.getElementById('sr2-i-rack').value = rack !== 'null' ? rack : '';
  document.getElementById('sr2-i-bin').value = bin !== 'null' ? bin : '';
  document.getElementById('sr2-item-modal-title').textContent = 'Edit Item';
  sr2_refreshCategoryOptions(dept).then(() => {
    document.getElementById('sr2-i-cat').value = cat !== 'null' ? cat : '';
  });
  document.getElementById('sr2-item-modal').classList.add('open');
}
async function sr2_submitItem(e) {
  e.preventDefault();
  const id = document.getElementById('sr2-i-id').value;
  const payload = {
    item_code: document.getElementById('sr2-i-code').value.trim(),
    name: document.getElementById('sr2-i-name').value.trim(),
    department: normalizeDeptValue(document.getElementById('sr2-i-dept').value),
    category_id: document.getElementById('sr2-i-cat').value || null,
    min_stock: document.getElementById('sr2-i-min').value || 0,
    max_stock: document.getElementById('sr2-i-max').value || 0,
    rack_number: document.getElementById('sr2-i-rack').value.trim(),
    bin_number: document.getElementById('sr2-i-bin').value.trim()
  };
  if (!payload.item_code || !payload.name) return toast('error','Validation','Item code and name are required');
  try {
    const url = id ? '/api/inventory/items/extended/'+id : '/api/inventory/items/extended';
    const method = id ? 'PUT' : 'POST';
    const res = await fetch(url, { method, headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload) });
    const data = await res.json();
    if(!res.ok) throw new Error(data.error || 'Failed to save item');
    toast('success','Saved successfully');
    sr2_closeModal('sr2-item-modal');
    sr2_loadItems();
    if (currentCategoryId) {
      sr2_loadCatItems(currentCategoryId);
    }
  } catch(err) { toast('error','Error', err.message); }
}

async function sr2_populateItemDropdowns(selectId, selectedId) {
  const select = document.getElementById(selectId);
  if (!select) return;
  try {
    const res = await fetch('/api/inventory/items?per_page=1000');
    const payload = await res.json();
    const itemList = Array.isArray(payload) ? payload : (payload.items || []);
    select.innerHTML = '<option value="">-- Select Item --</option>' + itemList.map(i => 
      `<option value="${i.id}" ${String(i.id) === String(selectedId) ? 'selected' : ''}>${i.name} (Code: ${i.item_code || 'N/A'}, Dept: ${i.department || 'N/A'}, Avail: ${i.available_qty || 0})</option>`
    ).join('');
  } catch(e) { console.error('Error populating item dropdown:', e); }
}

// Inward
async function sr2_loadInward() {
  try {
    const res = await fetch('/api/inventory/inward');
    const d = await res.json();
    const tbody = document.getElementById('sr2-inward-table')?.querySelector('tbody');
    if (!tbody) return;
    if (!Array.isArray(d) || !d.length) {
      tbody.innerHTML = '<tr><td colspan="9" style="text-align:center;padding:20px;color:var(--text-3)">No inward records found.</td></tr>';
      return;
    }
    tbody.innerHTML = d.map(r => {
      const dateStr = r.date ? String(r.date).substring(0,10) : '-';
      return `<tr>
        <td>${r.serial_no || '-'}</td><td>${dateStr}</td><td>${r.item_name || '-'} (${r.item_code || '-'})</td>
        <td>${r.supplier_name || '-'}</td><td>${r.po_no||'-'} / ${r.grn_number||'-'}</td>
        <td style="font-weight:bold;color:var(--green)">+${r.quantity_received || 0}</td><td>₹${r.unit_price || 0}</td><td>₹${r.total_value || 0}</td>
        <td>${r.remarks||'-'}</td>
      </tr>`;
    }).join('');
  } catch(e) { console.error(e); }
}
function sr2_openInwardModal(itemId) {
  const form = document.getElementById('sr2-inward-form');
  if (form) form.reset();
  const dateEl = document.getElementById('sr2-inw-date');
  if (dateEl) dateEl.value = new Date().toISOString().split('T')[0];
  sr2_populateItemDropdowns('sr2-inw-item', itemId);
  document.getElementById('sr2-inward-modal').classList.add('open');
}
async function sr2_submitInward(e) {
  e.preventDefault();
  const payload = {
    date: document.getElementById('sr2-inw-date').value,
    item_id: document.getElementById('sr2-inw-item').value,
    quantity_received: document.getElementById('sr2-inw-qty').value,
    unit_price: document.getElementById('sr2-inw-price').value,
    supplier_name: document.getElementById('sr2-inw-supplier').value.trim(),
    po_no: document.getElementById('sr2-inw-po').value.trim(),
    grn_number: document.getElementById('sr2-inw-grn').value.trim(),
    invoice_number: document.getElementById('sr2-inw-grn').value.trim(),
    remarks: document.getElementById('sr2-inw-remarks').value.trim()
  };
  if (!payload.supplier_name) return toast('error','Validation','Supplier is required');
  if (!payload.item_id || parseFloat(payload.quantity_received) <= 0) return toast('error','Validation','Valid item and quantity are required');
  try {
    const res = await fetch('/api/inventory/inward', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload) });
    const data = await res.json();
    if(!res.ok) throw new Error(data.error || 'Failed to save inward');
    toast('success','Inward Recorded');
    sr2_closeModal('sr2-inward-modal');
    sr2_loadInward();
    sr2_loadDashboard();
  } catch(err) { toast('error','Error', err.message); }
}

